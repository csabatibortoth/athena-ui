{
  "name": "athena-ui-js",
  "version": "2.0.0",
  "description": "A small UI framework (jQuery is optional): generated page layout, menus, login / registration / lost password forms, charts, tables, modals and themes, written as ES modules.",
  "type": "module",
  "main": "./src/athena-ui.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser/run.mjs",
    "docs": "node scripts/styling-docs.mjs"
  },
  "exports": {
    ".": "./src/athena-ui.js",
    "./classic": "./src/classic.js",
    "./testing": "./src/testing.js",
    "./theme-boot.js": "./src/theme-boot.js",
    "./table": "./src/table.js",
    "./chart": "./src/chart.js",
    "./dialog": "./src/dialog.js",
    "./menu": "./src/menu.js",
    "./navigation": "./src/navigation.js",
    "./forms": "./src/forms.js",
    "./feedback": "./src/feedback.js",
    "./components": "./src/components.js",
    "./inputs": "./src/inputs.js",
    "./router": "./src/router.js",
    "./session": "./src/session.js",
    "./theme": "./src/theme.js",
    "./i18n": "./src/i18n.js",
    "./format": "./src/format.js",
    "./validation": "./src/validation.js",
    "./sanitize": "./src/sanitize.js",
    "./csv": "./src/csv.js",
    "./dom": "./src/dom.js",
    "./controls": "./src/controls.js",
    "./themes/*": "./src/res/themes/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/libs/config",
    "src/libs/hephaestus/hephaestus.js",
    "src/libs/hephaestus/LayoutGenerator",
    "src/libs/hephaestus/MenuGenerator",
    "src/libs/hephaestus/formGenerator",
    "src/libs/core",
    "src/libs/hephaestus/auth",
    "src/libs/hephaestus/router",
    "src/libs/hephaestus/feedbackGenerator",
    "src/libs/hephaestus/dialogGenerator",
    "src/libs/hephaestus/navigationGenerator",
    "src/libs/hephaestus/componentGenerator",
    "src/libs/hephaestus/inputGenerator",
    "src/libs/hephaestus/chartGenerator",
    "src/libs/hephaestus/tableGenerator",
    "src/libs/hephaestus/modalGenerator",
    "src/res",
    "src/*.js",
    "!src/example.js"
  ],
  "sideEffects": [
    "./src/classic.js",
    "./src/theme-boot.js",
    "*.css"
  ],
  "keywords": [
    "ui",
    "framework",
    "jquery",
    "layout",
    "menu",
    "login-form",
    "registration-form",
    "chart",
    "table",
    "form-builder",
    "dialog",
    "router",
    "dark-theme",
    "i18n",
    "rich-text",
    "virtual-scroll",
    "modal",
    "themes",
    "es-modules"
  ],
  "peerDependencies": {
    "jquery": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "jquery": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csabatibortoth/athena-ui.git"
  },
  "homepage": "https://github.com/csabatibortoth/athena-ui#readme",
  "bugs": {
    "url": "https://github.com/csabatibortoth/athena-ui/issues"
  },
  "author": "Csaba Tóth (https://github.com/csabatibortoth)",
  "license": "MIT"
}
